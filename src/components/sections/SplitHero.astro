---
interface Props {
  eyebrow: string;
  title: string;
  accent?: string;
  description: string;
  imageSrc?: string;
  imageAlt?: string;
  labelledBy: string;
}

const { eyebrow, title, accent, description, imageSrc, imageAlt, labelledBy } = Astro.props;
---

<section class="split-hero" aria-labelledby={labelledBy}>
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="kicker">{eyebrow}</p>
      <h1 id={labelledBy}>
        {title}
        {accent && <span>{accent}</span>}
      </h1>
      <p>{description}</p>
    </div>
    <div class="hero-image-slot" aria-label={imageAlt ?? 'Imagen de apoyo'}>
      {
        imageSrc && (
          <img src={imageSrc} alt={imageAlt ?? ''} width="760" height="430" />
        )
      }
    </div>
  </div>
</section>

<style>
  .split-hero {
    padding-top: 156px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(320px, 0.96fr) minmax(440px, 1fr);
    gap: 72px;
    align-items: center;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 18px;
    color: var(--color-green-dark);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .kicker::before {
    content: "";
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-teal);
  }

  h1 {
    max-width: 760px;
    margin: 0;
    color: var(--color-navy);
    font-family: var(--font-display);
    font-size: clamp(3.15rem, 5.2vw, 4.8rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: 0;
  }

  h1 span {
    display: block;
    color: var(--color-green);
  }

  .hero-copy > p:last-child {
    max-width: 650px;
    margin: 32px 0 0;
    color: rgba(0, 0, 67, 0.68);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.62;
  }

  .hero-image-slot {
    min-height: 310px;
    overflow: hidden;
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(18, 70, 192, 0.08), rgba(0, 225, 173, 0.12)),
      #f7fbff;
    box-shadow: 0 24px 54px rgba(0, 0, 67, 0.06);
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 1180px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 760px) {
    .split-hero {
      padding-top: 112px;
    }

    h1 {
      font-size: clamp(2.5rem, 11vw, 3.1rem);
    }

    .hero-copy > p:last-child {
      font-size: 1rem;
    }

    .hero-image-slot {
      min-height: 260px;
    }
  }
</style>
