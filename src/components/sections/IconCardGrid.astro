---
import { Icon } from 'astro-icon/components';

interface CardItem {
  icon: string;
  title: string;
  copy?: string;
  tone?: 'green' | 'blue' | 'purple' | 'orange';
}

interface Props {
  items: readonly CardItem[];
  columns?: 2 | 3 | 4 | 5;
  variant?: 'inline' | 'stacked' | 'divided';
  labelledBy?: string;
}

const {
  items,
  columns = 4,
  variant = 'inline',
  labelledBy,
} = Astro.props;
---

<div
  class:list={['icon-card-grid', `columns-${columns}`, variant]}
  aria-labelledby={labelledBy}
>
  {
    items.map((item) => (
      <article>
        <span class:list={['icon-box', item.tone ?? 'green']}>
          <Icon name={item.icon} size={variant === 'stacked' ? 30 : 28} />
        </span>
        <div>
          <h3>{item.title}</h3>
          {item.copy && <p>{item.copy}</p>}
        </div>
      </article>
    ))
  }
</div>

<style>
  .icon-card-grid {
    display: grid;
    gap: 34px;
  }

  .columns-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .columns-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .columns-4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .columns-5 {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0;
  }

  article {
    display: grid;
    min-width: 0;
  }

  .inline article {
    grid-template-columns: 66px 1fr;
    gap: 18px;
    align-items: center;
  }

  .stacked article,
  .divided article {
    justify-items: center;
    gap: 16px;
    text-align: center;
  }

  .divided article {
    padding: 0 32px;
  }

  .divided article + article {
    border-left: 1px solid rgba(0, 0, 67, 0.12);
  }

  .icon-box {
    display: grid;
    width: 60px;
    height: 60px;
    place-items: center;
    border-radius: 8px;
  }

  .green {
    background: rgba(0, 225, 173, 0.18);
    color: var(--color-green-dark);
  }

  .blue {
    background: rgba(18, 70, 192, 0.13);
    color: var(--color-blue);
  }

  .purple {
    background: rgba(89, 91, 255, 0.14);
    color: var(--color-purple);
  }

  .orange {
    background: rgba(244, 155, 0, 0.18);
    color: var(--color-orange);
  }

  h3 {
    margin: 0 0 8px;
    color: var(--color-navy);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0;
  }

  p {
    margin: 0;
    color: rgba(0, 0, 67, 0.62);
    font-weight: 700;
    line-height: 1.55;
  }

  @media (max-width: 1180px) {
    .columns-3,
    .columns-4,
    .columns-5 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .divided article {
      padding: 28px;
    }

    .divided article + article,
    .divided article:nth-child(3) {
      border-left: 0;
    }
  }

  @media (max-width: 760px) {
    .icon-card-grid,
    .columns-2,
    .columns-3,
    .columns-4,
    .columns-5 {
      grid-template-columns: 1fr;
    }

    .icon-card-grid {
      gap: 28px;
    }

    .divided article,
    .divided article + article {
      border-left: 0;
      padding: 24px 0;
    }
  }
</style>
