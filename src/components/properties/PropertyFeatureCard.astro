---
import { Icon } from 'astro-icon/components';

interface Props {
  property: {
    status: string;
    title: string;
    location: string;
    price: string;
    suffix?: string;
    meta: readonly string[];
    tone: string;
    image?: string;
    imageSrc?: string;
    imageAlt?: string;
  };
}

const { property } = Astro.props;
---

<article class="property-card">
  <div class="property-media">
    <span class:list={['status', property.tone]}>{property.status}</span>
    <div class="image-slot">
      {
        property.imageSrc ? (
          <img
            src={property.imageSrc}
            alt={property.imageAlt ?? property.title}
            width="420"
            height="260"
            loading="lazy"
          />
        ) : (
          <span>{property.image}</span>
        )
      }
    </div>
  </div>
  <div class="property-body">
    <div class="property-title-row">
      <h3>{property.title}</h3>
      <button type="button" aria-label={`Guardar ${property.title}`}>
        <Icon name="solar:heart-linear" size={24} />
      </button>
    </div>
    <p>{property.location}</p>
    <ul aria-label="Características de la propiedad">
      <li><Icon name="solar:bed-linear" size={17} /> {property.meta[0]}</li>
      <li><Icon name="solar:bath-linear" size={17} /> {property.meta[1]}</li>
      <li><Icon name="solar:ruler-linear" size={17} /> {property.meta[2]}</li>
    </ul>
    <strong class:list={['price', { 'blue-price': property.tone === 'blue' }]}>
      {property.price}
      {property.suffix && <small>{property.suffix}</small>}
    </strong>
  </div>
</article>

<style>
  .property-card {
    overflow: hidden;
    border: 1px solid rgba(0, 0, 67, 0.08);
    border-radius: 8px;
    background: #ffffff;
    box-shadow: var(--shadow-card);
  }

  .property-media {
    position: relative;
  }

  .image-slot {
    display: grid;
    width: 100%;
    aspect-ratio: 420 / 260;
    place-items: center;
    overflow: hidden;
    background:
      linear-gradient(135deg, rgba(18, 70, 192, 0.09), rgba(0, 225, 173, 0.08)),
      #f8fbff;
    color: rgba(0, 0, 67, 0.48);
    text-align: center;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-slot span {
    font-weight: 700;
  }

  .status {
    position: absolute;
    top: 26px;
    left: 22px;
    z-index: 2;
    display: inline-flex;
    min-height: 34px;
    align-items: center;
    padding: 0 18px;
    border-radius: 999px;
    color: #ffffff;
    font-size: 0.86rem;
    font-weight: 700;
  }

  .status.green {
    background: var(--color-mint);
  }

  .status.blue {
    background: var(--color-blue);
  }

  .property-body {
    padding: 27px 25px 30px;
  }

  .property-title-row {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 18px;
  }

  h3 {
    margin: 0;
    color: var(--color-navy);
    font-size: 1.18rem;
    line-height: 1.25;
  }

  button {
    display: grid;
    flex: 0 0 auto;
    width: 36px;
    height: 36px;
    place-items: center;
    border: 0;
    background: transparent;
    color: rgba(0, 0, 67, 0.45);
    cursor: pointer;
  }

  p {
    margin: 10px 0 22px;
    color: rgba(0, 0, 67, 0.58);
    font-weight: 700;
  }

  ul {
    display: flex;
    gap: 22px;
    margin: 0 0 30px;
    padding: 0;
    color: rgba(0, 0, 67, 0.55);
    list-style: none;
    font-weight: 700;
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .price {
    display: block;
    color: var(--color-green);
    font-size: 1.42rem;
  }

  .price.blue-price {
    color: var(--color-blue);
  }

  small {
    margin-left: 3px;
    color: rgba(0, 0, 67, 0.6);
    font-size: 0.78rem;
  }
</style>
