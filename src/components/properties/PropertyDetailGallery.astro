---
import { Icon } from 'astro-icon/components'

interface Props {
  image: string
  images: readonly string[]
  title: string
}

const { image, images, title } = Astro.props
const gallerySources = images.length > 0 ? images : [image]
const galleryImages = gallerySources.map((src, index) => ({
  src,
  alt: `Imagen ${index + 1} de ${title}`,
  position: index + 1,
}))
const totalImages = galleryImages.length
---

<section
  class="gallery"
  aria-label="Galería de la propiedad"
  data-property-gallery
  data-gallery-total={totalImages}
>
  <figure class="main-photo">
    <img
      src={galleryImages[0].src}
      alt={galleryImages[0].alt}
      width="860"
      height="540"
      data-gallery-main
    />
    <figcaption>
      <Icon name="solar:camera-linear" size={16} />
      <span data-gallery-counter>{galleryImages[0].position} / {totalImages}</span>
    </figcaption>
  </figure>
  <div
    class="thumb-row"
    aria-label="Miniaturas de la propiedad"
    style={`--gallery-columns: ${Math.min(totalImages, 5)}`}
  >
    {
      galleryImages.map((item) => (
        <button
          class:list={{ active: item.position === 1 }}
          type="button"
          aria-label={`Ver imagen ${item.position}`}
          aria-pressed={item.position === 1 ? 'true' : 'false'}
          data-gallery-thumbnail
          data-full-src={item.src}
          data-full-alt={item.alt}
          data-position={item.position}
        >
          <img src={item.src} alt="" width="150" height="94" loading="lazy" />
        </button>
      ))
    }
  </div>
</section>

<script>
  const galleries = document.querySelectorAll<HTMLElement>(
    '[data-property-gallery]'
  )

  galleries.forEach((gallery) => {
    const mainImage = gallery.querySelector<HTMLImageElement>(
      '[data-gallery-main]'
    )
    const counter = gallery.querySelector<HTMLElement>('[data-gallery-counter]')
    const thumbnails = [
      ...gallery.querySelectorAll<HTMLButtonElement>(
        '[data-gallery-thumbnail]'
      ),
    ]

    if (!mainImage || !counter || thumbnails.length === 0) return

    thumbnails.forEach((thumbnail) => {
      thumbnail.addEventListener('click', () => {
        const nextSrc = thumbnail.dataset.fullSrc
        const nextAlt = thumbnail.dataset.fullAlt
        const nextPosition = thumbnail.dataset.position

        if (!nextSrc || !nextAlt || !nextPosition) return

        mainImage.src = nextSrc
        mainImage.alt = nextAlt
        counter.textContent = `${nextPosition} / ${gallery.dataset.galleryTotal}`

        thumbnails.forEach((item) => {
          const isActive = item === thumbnail
          item.classList.toggle('active', isActive)
          item.setAttribute('aria-pressed', String(isActive))
        })
      })
    })
  })
</script>

<style>
  .main-photo {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: 8px;
    background: #f6fbff;
    aspect-ratio: 860 / 470;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  figcaption {
    position: absolute;
    right: 18px;
    bottom: 18px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 34px;
    padding: 0 12px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.58);
    color: #ffffff;
    font-weight: 700;
  }

  .thumb-row {
    display: grid;
    grid-template-columns: repeat(var(--gallery-columns), minmax(0, 1fr));
    gap: 16px;
    margin-top: 18px;
  }

  .thumb-row button {
    min-width: 0;
    min-height: 98px;
    overflow: hidden;
    border: 0;
    border-radius: 8px;
    background: #f6fbff;
    cursor: pointer;
  }

  .thumb-row button.active {
    border: 3px solid var(--color-teal);
    padding: 0;
  }

  @media (max-width: 760px) {
    .main-photo {
      aspect-ratio: 1 / 0.78;
    }

    .thumb-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .thumb-row button {
      min-height: 88px;
    }
  }
</style>
