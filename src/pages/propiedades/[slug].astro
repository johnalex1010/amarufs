---
import SiteHeader from '@/components/SiteHeader.astro';
import PageHero from '@/components/PageHero.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

export function getStaticPaths() {
  // Sin fuente de datos conectada, no se generan rutas de detalle.
  // Conectar WordPress headless u otra fuente antes de poblar esta función.
  return [];
}
---

<BaseLayout title="Detalle de propiedad | Amarufs Inmobiliaria">
  <SiteHeader />
  <main>
    <PageHero
      eyebrow="Detalle de propiedad"
      title="Información completa de la propiedad"
      description="Esta vista queda preparada para mostrar imágenes, características, precio, ubicación y descripción cuando conectemos WordPress headless."
    />
  </main>
  <SiteFooter />
</BaseLayout>
