---
import { existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import { Icon } from 'astro-icon/components';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PropertyDetailContent from '@/components/properties/PropertyDetailContent.astro';
import PropertyDetailGallery from '@/components/properties/PropertyDetailGallery.astro';
import PropertyDetailSidebar from '@/components/properties/PropertyDetailSidebar.astro';
import {
  propertyBuildingFeatures,
  propertyDetail,
  propertyHighlights,
  propertyMainFeatures,
  propertyStats,
} from '@/data/siteContent';

export function getStaticPaths() {
  return [{ params: { slug: propertyDetail.slug } }];
}

const imageExtensions = new Set(['.avif', '.jpg', '.jpeg', '.png', '.webp']);
const propertyImagesDirectory = join(
  process.cwd(),
  'public',
  'images',
  'properties',
  propertyDetail.slug
);

const propertyGalleryImages = existsSync(propertyImagesDirectory)
  ? readdirSync(propertyImagesDirectory, { withFileTypes: true })
      .filter((entry) => {
        const extension = entry.name.slice(entry.name.lastIndexOf('.')).toLowerCase();
        return entry.isFile() && imageExtensions.has(extension);
      })
      .map((entry) => `/images/properties/${propertyDetail.slug}/${entry.name}`)
      .sort((currentImage, nextImage) => currentImage.localeCompare(nextImage, 'es'))
  : [];

const galleryImages = propertyGalleryImages.includes(propertyDetail.image)
  ? [
      propertyDetail.image,
      ...propertyGalleryImages.filter((galleryImage) => galleryImage !== propertyDetail.image),
    ]
  : propertyGalleryImages;
---

<BaseLayout
  title={`${propertyDetail.title} | Amaru FS Inmobiliaria`}
  description="Detalle de departamento moderno en venta en Surco, Lima, con características, ubicación y opciones de contacto de Amaru FS Inmobiliaria."
>
  <SiteHeader />
  <main class="detail-page">
    <section class="detail-shell" aria-labelledby="property-title">
      <nav class="breadcrumbs" aria-label="Ruta de navegación">
        <a href="/">Inicio</a>
        <Icon name="solar:alt-arrow-right-linear" size={14} />
        <a href="/propiedades/">Propiedades</a>
        <Icon name="solar:alt-arrow-right-linear" size={14} />
        <span>{propertyDetail.title}</span>
      </nav>

      <div class="title-row">
        <div>
          <span class="status">{propertyDetail.status}</span>
          <h1 id="property-title">{propertyDetail.title}</h1>
          <p class="location">
            <Icon name="solar:map-point-linear" size={18} />
            {propertyDetail.location}
          </p>
        </div>
        <div class="title-actions" aria-label="Acciones de propiedad">
          <button type="button"><Icon name="solar:heart-linear" size={19} />Guardar</button>
          <button type="button"><Icon name="solar:share-linear" size={19} />Compartir</button>
        </div>
      </div>

      <div class="detail-grid">
        <div class="main-column">
          <PropertyDetailGallery
            image={propertyDetail.image}
            images={galleryImages}
            title={propertyDetail.title}
          />
          <PropertyDetailContent
            highlights={propertyHighlights}
            features={propertyMainFeatures}
            buildingFeatures={propertyBuildingFeatures}
            description={propertyDetail.description}
            location={propertyDetail.location}
          />
        </div>

        <PropertyDetailSidebar
          price={propertyDetail.price}
          priceLabel={propertyDetail.priceLabel}
          stats={propertyStats}
        />
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .detail-page {
    padding-top: 138px;
  }

  .detail-shell {
    width: min(calc(100% - var(--site-padding-x)), var(--site-max-width));
    margin-inline: auto;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 30px;
    color: rgba(0, 0, 67, 0.62);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .breadcrumbs a {
    color: rgba(0, 0, 67, 0.68);
  }

  .title-row {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 28px;
    margin-bottom: 28px;
  }

  .status {
    display: inline-flex;
    min-height: 34px;
    align-items: center;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--color-mint);
    color: #ffffff;
    font-size: 0.86rem;
    font-weight: 700;
  }

  h1 {
    margin: 22px 0 14px;
    color: var(--color-navy);
    font-size: clamp(2rem, 3.3vw, 3rem);
    line-height: 1.12;
    letter-spacing: 0;
  }

  .location {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: rgba(0, 0, 67, 0.66);
    font-weight: 700;
  }

  .title-actions {
    display: flex;
    gap: 14px;
  }

  .title-actions button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 22px;
    border: 1.5px solid rgba(18, 70, 192, 0.55);
    border-radius: 8px;
    background: #ffffff;
    color: var(--color-blue);
    font-weight: 700;
    cursor: pointer;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 440px;
    gap: 28px;
    align-items: start;
  }

  .main-column {
    display: grid;
    gap: 28px;
  }

  @media (max-width: 1180px) {
    .title-row,
    .detail-grid {
      display: grid;
      grid-template-columns: 1fr;
    }

    .title-actions {
      justify-content: start;
    }
  }

  @media (max-width: 760px) {
    .detail-page {
      padding-top: 104px;
    }

    .detail-shell {
      width: min(calc(100% - var(--site-padding-x-mobile)), var(--site-max-width));
    }

    .breadcrumbs {
      gap: 8px;
      font-size: 0.82rem;
    }

    h1 {
      font-size: 2rem;
    }

    .title-actions {
      display: grid;
      grid-template-columns: 1fr;
    }
  }
</style>
