---
import { Icon } from 'astro-icon/components'
import SiteHeader from '@/components/SiteHeader.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const propertyImage = '/images/properties/propiedad.jpg'

const propertyTypes = [
  'Departamentos (12)',
  'Casas (8)',
  'Terrenos (4)',
  'Oficinas (2)',
  'Locales comerciales (1)',
]

const properties = [
  {
    status: 'En venta',
    title: 'Departamento moderno',
    location: 'Surco, Lima',
    price: 'S/ 520,000',
    description:
      'Departamento con excelente iluminación natural, acabados de primera y áreas comunes.',
    meta: [
      { icon: 'solar:bed-linear', label: '2 habitaciones', value: '2' },
      { icon: 'solar:bath-linear', label: '2 baños', value: '2' },
      {
        icon: 'solar:ruler-linear',
        label: '85 metros cuadrados',
        value: '85 m²',
      },
      { icon: 'solar:layers-linear', label: 'Piso 5', value: 'Piso 5' },
    ],
    tone: 'green',
    gallery: '1 / 12',
  },
  {
    status: 'En alquiler',
    title: 'Casa familiar',
    location: 'La Molina, Lima',
    price: 'S/ 4,500',
    suffix: '/mes',
    description:
      'Amplia casa en zona residencial tranquila, ideal para familias.',
    meta: [
      { icon: 'solar:bed-linear', label: '4 habitaciones', value: '4' },
      { icon: 'solar:bath-linear', label: '3 baños', value: '3' },
      {
        icon: 'solar:ruler-linear',
        label: '160 metros cuadrados',
        value: '160 m²',
      },
      { icon: 'solar:home-2-linear', label: '2 pisos', value: '2 pisos' },
    ],
    tone: 'blue',
    gallery: '1 / 10',
  },
  {
    status: 'En venta',
    title: 'Casa minimalista',
    location: 'Cieneguilla, Lima',
    price: 'S/ 750,000',
    description:
      'Diseño moderno con jardín amplio, terraza y piscina. Perfecta para disfrutar en familia.',
    meta: [
      { icon: 'solar:bed-linear', label: '3 habitaciones', value: '3' },
      { icon: 'solar:bath-linear', label: '3 baños', value: '3' },
      {
        icon: 'solar:ruler-linear',
        label: '120 metros cuadrados',
        value: '120 m²',
      },
      { icon: 'solar:home-2-linear', label: '2 pisos', value: '2 pisos' },
    ],
    tone: 'green',
    gallery: '1 / 14',
  },
  {
    status: 'En venta',
    title: 'Terreno en venta',
    location: 'Pachacamac, Lima',
    price: 'S/ 350,000',
    description:
      'Terreno plano ideal para proyecto de casa de campo o inversión.',
    meta: [
      {
        icon: 'solar:ruler-angular-linear',
        label: '1,000 metros cuadrados',
        value: '1,000 m²',
      },
    ],
    tone: 'green',
    gallery: '1 / 6',
  },
]
---

<BaseLayout
  title="Propiedades | Amaru FS Inmobiliaria"
  description="Explora propiedades en venta y alquiler con filtros útiles y acompañamiento especializado de Amaru FS Inmobiliaria."
>
  <SiteHeader />
  <main>
    <section class="properties-hero" aria-labelledby="properties-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="kicker">Propiedades</p>
          <h1 id="properties-title">Propiedades</h1>
          <p>
            Encuentra la propiedad ideal con la guía y el respaldo de expertos.
          </p>
        </div>
        <div
          class="hero-media"
          aria-label="Espacio reservado para imagen principal"
        >
          <img
            src="/images/properties/hero-propiedades.png"
            alt="Propiedades"
            loading="eager"
          />
        </div>
      </div>

      <form
        class="search-panel"
        action="/propiedades/"
        aria-label="Buscar propiedades"
      >
        <label class="search-keyword">
          <Icon name="solar:magnifer-linear" size={22} />
          <span class="sr-only"
            >Buscar por ubicación, propiedad o palabra clave</span
          >
          <input
            type="search"
            name="q"
            placeholder="Buscar por ubicación, propiedad o palabra clave"
          />
        </label>

        <label class="select-field">
          <span>Tipo de propiedad</span>
          <select name="tipo">
            <option>Todos los tipos</option>
            <option>Departamentos</option>
            <option>Casas</option>
            <option>Terrenos</option>
            <option>Oficinas</option>
          </select>
        </label>

        <label class="select-field">
          <span>Rango de precio</span>
          <select name="precio">
            <option>Cualquier rango</option>
            <option>Hasta S/ 350,000</option>
            <option>S/ 350,000 a S/ 750,000</option>
            <option>Más de S/ 750,000</option>
          </select>
        </label>

        <button class="search-button" type="submit">
          <Icon name="solar:tuning-2-linear" size={22} />
          Buscar propiedades
        </button>
      </form>
    </section>

    <section class="properties-shell" aria-labelledby="results-title">
      <aside class="filters-panel" aria-label="Filtros de propiedades">
        <div class="filters-heading">
          <h2>Filtros</h2>
          <button type="button">Limpiar</button>
        </div>

        <div class="filter-group">
          <h3><Icon name="solar:map-point-linear" size={18} /> Ubicación</h3>
          <label class="select-field compact">
            <span class="sr-only">Ubicación</span>
            <select name="ubicacion">
              <option>Todas las ubicaciones</option>
              <option>Surco, Lima</option>
              <option>La Molina, Lima</option>
              <option>Cieneguilla, Lima</option>
              <option>Pachacamac, Lima</option>
            </select>
          </label>
        </div>

        <div class="filter-group">
          <h3>
            <Icon name="solar:home-2-linear" size={18} /> Tipo de propiedad
          </h3>
          <label class="check-row"
            ><input type="checkbox" checked /> Todos los tipos</label
          >
          {
            propertyTypes.map((type) => (
              <label class="check-row">
                <input type="checkbox" /> {type}
              </label>
            ))
          }
        </div>

        <div class="filter-group">
          <h3><Icon name="solar:tag-linear" size={18} /> Estado</h3>
          <label class="check-row"
            ><input type="checkbox" checked /> En venta</label
          >
          <label class="check-row"><input type="checkbox" /> En alquiler</label>
        </div>

        <div class="filter-group">
          <h3>
            <Icon name="solar:home-smile-angle-linear" size={18} /> Rango de precio
          </h3>
          <div class="range-track" aria-hidden="true"><span></span></div>
          <div class="range-labels">
            <span>S/ 0</span><span>S/ 2,000,000+</span>
          </div>
        </div>

        <div class="filter-group">
          <h3><Icon name="solar:home-2-linear" size={18} /> Habitaciones</h3>
          <div class="step-options" aria-label="Número de habitaciones">
            <button type="button">1+</button>
            <button type="button">2+</button>
            <button type="button">3+</button>
            <button type="button">4+</button>
          </div>
        </div>

        <div class="filter-group">
          <h3><Icon name="solar:ruler-linear" size={18} /> Área (m²)</h3>
          <div class="range-track" aria-hidden="true"><span></span></div>
          <div class="range-labels"><span>0 m²</span><span>500+ m²</span></div>
        </div>

        <button class="apply-button" type="button">
          Aplicar filtros
          <Icon name="solar:tuning-2-linear" size={18} />
        </button>
      </aside>

      <div class="results-area">
        <div class="results-toolbar">
          <h2 id="results-title">
            <strong>18</strong> propiedades encontradas
          </h2>
          <label>
            <span>Ordenar por:</span>
            <select name="orden">
              <option>Más recientes</option>
              <option>Mayor precio</option>
              <option>Menor precio</option>
            </select>
          </label>
        </div>

        <div class="property-list">
          {
            properties.map((property) => (
              <article class="property-card">
                <div class="property-media">
                  <img
                    src={propertyImage}
                    alt={`Imagen referencial de ${property.title}`}
                    width="440"
                    height="272"
                    loading="lazy"
                  />
                  <span class={`status ${property.tone}`}>
                    {property.status}
                  </span>
                  <button
                    type="button"
                    aria-label={`Guardar ${property.title}`}
                  >
                    <Icon name="solar:heart-linear" size={28} />
                  </button>
                  <span class="gallery-count">
                    <Icon name="solar:camera-linear" size={14} />
                    {property.gallery}
                  </span>
                </div>

                <div class="property-content">
                  <h3>{property.title}</h3>
                  <p class="location">
                    <Icon name="solar:map-point-linear" size={16} />
                    {property.location}
                  </p>
                  <ul aria-label={`Características de ${property.title}`}>
                    {property.meta.map((item) => (
                      <li title={item.label}>
                        <Icon name={item.icon} size={17} />
                        {item.value}
                      </li>
                    ))}
                  </ul>
                  <p class="description">{property.description}</p>
                  <div class="card-footer">
                    <strong>
                      {property.price}
                      {property.suffix && <small>{property.suffix}</small>}
                    </strong>
                    <a href="/propiedades/departamento-moderno-en-surco/">
                      Ver detalles
                      <Icon name="solar:arrow-right-linear" size={18} />
                    </a>
                  </div>
                </div>
              </article>
            ))
          }
        </div>

        <nav class="pagination" aria-label="Paginación de propiedades">
          <a href="/propiedades/" aria-label="Página anterior"
            ><Icon name="solar:alt-arrow-left-linear" size={18} /></a
          >
          <a class="active" href="/propiedades/" aria-current="page">1</a>
          <a href="/propiedades/">2</a>
          <a href="/propiedades/">3</a>
          <a href="/propiedades/" aria-label="Página siguiente"
            ><Icon name="solar:alt-arrow-right-linear" size={18} /></a
          >
        </nav>
      </div>
    </section>

    <section class="support-banner" aria-labelledby="support-title">
      <span class="support-icon"
        ><Icon name="solar:home-2-linear" size={44} /></span
      >
      <div>
        <h2 id="support-title">¿No encuentras lo que buscas?</h2>
        <p>
          Cuéntanos qué necesitas y te ayudamos a encontrar la propiedad ideal.
        </p>
      </div>
      <a href="#contacto">
        Contáctanos
        <Icon name="solar:arrow-right-linear" size={20} />
      </a>
      <Icon class="support-mark" name="solar:buildings-2-linear" size={220} />
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .properties-hero {
    position: relative;
    padding: 152px 0 0;
    background: linear-gradient(180deg, #ffffff 0%, #ffffff 78%, #f7fbff 100%);
  }

  .hero-inner,
  .search-panel,
  .properties-shell,
  .support-banner {
    width: min(calc(100% - var(--site-padding-x)), var(--site-max-width));
    margin-inline: auto;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(300px, 0.9fr) minmax(420px, 1.15fr);
    align-items: end;
    gap: 56px;
    min-height: 300px;
  }

  .hero-copy {
    padding-bottom: 76px;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    margin: 0 0 16px;
    color: var(--color-green-dark);
    font-size: 0;
    font-weight: 700;
  }

  .kicker::before {
    content: '';
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-teal);
  }

  h1 {
    margin: 0;
    color: var(--color-navy);
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 6.2vw, 5.8rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0;
  }

  .hero-copy > p:last-child {
    max-width: 410px;
    margin: 28px 0 0;
    color: rgba(0, 0, 67, 0.68);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .hero-media {
    min-height: 280px;
    border-radius: 8px;
    margin: 0 auto 0;
  }

  .search-panel {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns:
      minmax(260px, 1.45fr) minmax(190px, 0.7fr) minmax(190px, 0.7fr)
      auto;
    gap: 18px;
    margin-top: -24px;
    padding: 28px;
    border: 1px solid rgba(0, 0, 67, 0.09);
    border-radius: 8px;
    background: #ffffff;
    box-shadow: var(--shadow-panel);
  }

  .search-keyword,
  .select-field,
  .results-toolbar label {
    display: grid;
    align-items: center;
    min-height: 68px;
    border: 1px solid rgba(0, 0, 67, 0.12);
    border-radius: 8px;
    background: #ffffff;
  }

  .search-keyword {
    grid-template-columns: auto 1fr;
    gap: 14px;
    padding: 0 20px;
    color: var(--color-navy);
  }

  .search-keyword input,
  .select-field select,
  .results-toolbar select {
    width: 100%;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--color-navy);
    font-weight: 700;
    outline: none;
  }

  .search-keyword input::placeholder {
    color: rgba(0, 0, 67, 0.44);
  }

  .select-field {
    grid-template-rows: auto auto;
    gap: 4px;
    padding: 11px 16px;
  }

  .select-field span,
  .results-toolbar label span {
    color: rgba(0, 0, 67, 0.58);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .search-button,
  .apply-button,
  .support-banner a,
  .card-footer a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 58px;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
  }

  .search-button {
    min-width: 220px;
    border: 0;
    background: var(--color-blue);
    color: #ffffff;
    cursor: pointer;
    box-shadow: var(--shadow-button);
  }

  .properties-shell {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: 36px;
    padding: 34px 0 0;
  }

  .filters-panel,
  .property-card {
    border: 1px solid rgba(0, 0, 67, 0.09);
    border-radius: 8px;
    background: #ffffff;
    box-shadow: 0 16px 38px rgba(0, 0, 67, 0.05);
  }

  .filters-panel {
    align-self: start;
    padding: 28px 24px;
  }

  .filters-heading,
  .results-toolbar,
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .filters-heading h2,
  .results-toolbar h2,
  .support-banner h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: 0;
  }

  .filters-heading h2 {
    font-family: var(--font-sans);
    font-size: 1.08rem;
    font-weight: 700;
  }

  .filters-heading button {
    border: 0;
    background: transparent;
    color: var(--color-blue);
    font-weight: 700;
    cursor: pointer;
  }

  .filter-group {
    padding: 28px 0;
    border-bottom: 1px solid rgba(0, 0, 67, 0.1);
  }

  .filter-group:last-of-type {
    border-bottom: 0;
  }

  .filter-group h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 16px;
    font-size: 0.98rem;
  }

  .select-field.compact {
    min-height: 48px;
    padding: 0 12px;
  }

  .check-row {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 32px;
    color: rgba(0, 0, 67, 0.76);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .check-row input {
    width: 18px;
    height: 18px;
    accent-color: var(--color-blue);
  }

  .range-track {
    position: relative;
    height: 18px;
  }

  .range-track::before,
  .range-track span {
    content: '';
    position: absolute;
    top: 7px;
    left: 0;
    right: 0;
    height: 4px;
    border-radius: 999px;
  }

  .range-track::before {
    background: rgba(0, 0, 67, 0.1);
  }

  .range-track span {
    background: var(--color-teal);
  }

  .range-track span::before,
  .range-track span::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 18px;
    height: 18px;
    border: 2px solid var(--color-teal);
    border-radius: 50%;
    background: #ffffff;
    transform: translateY(-50%);
  }

  .range-track span::before {
    left: 0;
  }

  .range-track span::after {
    right: 0;
  }

  .range-labels {
    display: flex;
    justify-content: space-between;
    margin-top: 10px;
    color: rgba(0, 0, 67, 0.66);
    font-size: 0.92rem;
    font-weight: 700;
  }

  .step-options {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }

  .step-options button {
    min-height: 40px;
    border: 1px solid rgba(0, 0, 67, 0.14);
    border-radius: 8px;
    background: #ffffff;
    color: rgba(0, 0, 67, 0.64);
    font-weight: 700;
    cursor: pointer;
  }

  .apply-button {
    width: 100%;
    margin-top: 22px;
    border: 1.5px solid var(--color-teal);
    background: #ffffff;
    color: var(--color-green-dark);
    cursor: pointer;
  }

  .results-toolbar {
    min-height: 64px;
    margin-bottom: 28px;
  }

  .results-toolbar h2 {
    color: rgba(0, 0, 67, 0.66);
    font-family: var(--font-sans);
    font-size: 1.18rem;
    font-weight: 700;
  }

  .results-toolbar h2 strong {
    color: var(--color-green);
    font-size: 1.45rem;
  }

  .results-toolbar label {
    grid-template-columns: auto minmax(130px, 1fr);
    gap: 12px;
    min-height: 52px;
    padding: 0 14px;
  }

  .property-list {
    display: grid;
    gap: 22px;
  }

  .property-card {
    display: grid;
    grid-template-columns: minmax(260px, 440px) minmax(0, 1fr);
    overflow: hidden;
  }

  .property-media {
    position: relative;
    min-height: 272px;
    overflow: hidden;
  }

  .property-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .property-media button {
    position: absolute;
    top: 18px;
    right: 18px;
    display: grid;
    width: 46px;
    height: 46px;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    color: rgba(0, 0, 67, 0.58);
    cursor: pointer;
  }

  .status {
    position: absolute;
    top: 24px;
    left: 24px;
    display: inline-flex;
    min-height: 34px;
    align-items: center;
    padding: 0 18px;
    border-radius: 999px;
    color: #ffffff;
    font-size: 0.86rem;
    font-weight: 700;
  }

  .status.green {
    background: var(--color-mint);
  }

  .status.blue {
    background: var(--color-blue);
  }

  .gallery-count {
    position: absolute;
    right: 16px;
    bottom: 16px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 28px;
    padding: 0 9px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.58);
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .property-content {
    display: grid;
    align-content: start;
    padding: 28px 32px;
  }

  .property-content h3 {
    margin: 0 0 10px;
    color: var(--color-navy);
    font-size: 1.55rem;
    line-height: 1.2;
  }

  .location,
  .description {
    color: rgba(0, 0, 67, 0.62);
    font-weight: 700;
    line-height: 1.55;
  }

  .location {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 18px;
    font-size: 0.95rem;
  }

  .property-content ul {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 26px;
    margin: 0 0 20px;
    padding: 0;
    list-style: none;
    color: rgba(0, 0, 67, 0.56);
    font-weight: 700;
  }

  .property-content li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .description {
    margin: 0 0 24px;
  }

  .card-footer {
    margin-top: auto;
  }

  .card-footer strong {
    color: var(--color-green);
    font-size: 1.45rem;
  }

  .card-footer small {
    margin-left: 4px;
    color: rgba(0, 0, 67, 0.58);
    font-size: 0.82rem;
  }

  .card-footer a {
    min-width: 156px;
    min-height: 48px;
    border: 1.5px solid var(--color-blue);
    color: var(--color-blue);
  }

  .pagination {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 32px;
  }

  .pagination a {
    display: grid;
    min-width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid rgba(0, 0, 67, 0.12);
    border-radius: 8px;
    color: var(--color-navy);
    font-weight: 700;
  }

  .pagination a.active {
    border-color: var(--color-blue);
    background: var(--color-blue);
    color: #ffffff;
  }

  .support-banner {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 28px;
    align-items: center;
    min-height: 150px;
    margin-top: 52px;
    overflow: hidden;
    padding: 30px 62px;
    border-radius: 8px;
    background: linear-gradient(105deg, var(--color-blue), var(--color-mint));
    color: #ffffff;
  }

  .support-icon {
    display: grid;
    width: 76px;
    height: 76px;
    place-items: center;
    border-radius: 50%;
    background: #ffffff;
    color: var(--color-green);
  }

