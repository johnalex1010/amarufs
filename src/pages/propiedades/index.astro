---
import { Icon } from 'astro-icon/components';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBanner from '@/components/sections/CtaBanner.astro';
import PropertyListCard from '@/components/properties/PropertyListCard.astro';
import { listedProperties, propertyTypes } from '@/data/siteContent';

const propertyImage = '/images/properties/departamento-moderno-en-surco/propiedad.jpg';
---

<BaseLayout
  title="Propiedades | Amaru FS Inmobiliaria"
  description="Explora propiedades en venta y alquiler con filtros útiles y acompañamiento especializado de Amaru FS Inmobiliaria."
>
  <SiteHeader />
  <main>
    <section class="properties-hero" aria-labelledby="properties-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="kicker">Propiedades</p>
          <h1 id="properties-title">Propiedades</h1>
          <p>Encuentra la propiedad ideal con la guía y el respaldo de expertos.</p>
        </div>
        <div class="hero-media" aria-label="Imagen principal de propiedades">
          <img
            src="/images/properties/hero-propiedades.png"
            alt="Propiedades disponibles con Amaru FS Inmobiliaria"
            loading="eager"
            width="720"
            height="360"
          />
        </div>
      </div>

      <form class="search-panel" action="/propiedades/" aria-label="Buscar propiedades">
        <label class="search-keyword">
          <Icon name="solar:magnifer-linear" size={22} />
          <span class="sr-only">Buscar por ubicación, propiedad o palabra clave</span>
          <input type="search" name="q" placeholder="Ubicación o palabra clave" />
        </label>

        <label class="select-field">
          <span>Tipo de propiedad</span>
          <select name="tipo">
            <option>Todos los tipos</option>
            <option>Departamentos</option>
            <option>Casas</option>
            <option>Terrenos</option>
            <option>Oficinas</option>
          </select>
        </label>

        <label class="select-field">
          <span>Rango de precio</span>
          <select name="precio">
            <option>Cualquier rango</option>
            <option>Hasta S/ 350,000</option>
            <option>S/ 350,000 a S/ 750,000</option>
            <option>Más de S/ 750,000</option>
          </select>
        </label>

        <button class="search-button" type="submit">
          <Icon name="solar:tuning-2-linear" size={22} />
          Buscar propiedades
        </button>
      </form>
    </section>

    <section class="properties-shell" aria-labelledby="results-title">
      <aside class="filters-panel" aria-label="Filtros de propiedades">
        <div class="filters-heading">
          <h2>Filtros</h2>
          <button type="button">Limpiar</button>
        </div>

        <div class="filter-group">
          <h3><Icon name="solar:map-point-linear" size={18} /> Ubicación</h3>
          <label class="select-field compact">
            <span class="sr-only">Ubicación</span>
            <select name="ubicacion">
              <option>Todas las ubicaciones</option>
              <option>Surco, Lima</option>
              <option>La Molina, Lima</option>
              <option>Cieneguilla, Lima</option>
              <option>Pachacamac, Lima</option>
            </select>
          </label>
        </div>

        <div class="filter-group">
          <h3><Icon name="solar:home-2-linear" size={18} /> Tipo de propiedad</h3>
          <label class="check-row"><input type="checkbox" checked /> Todos los tipos</label>
          {propertyTypes.map((type) => <label class="check-row"><input type="checkbox" /> {type}</label>)}
        </div>

        <div class="filter-group">
          <h3><Icon name="solar:tag-linear" size={18} /> Estado</h3>
          <label class="check-row"><input type="checkbox" checked /> En venta</label>
          <label class="check-row"><input type="checkbox" /> En alquiler</label>
        </div>

        <div class="filter-group">
          <h3><Icon name="solar:home-smile-angle-linear" size={18} /> Rango de precio</h3>
          <div class="range-track" aria-hidden="true"><span></span></div>
          <div class="range-labels"><span>S/ 0</span><span>S/ 2,000,000+</span></div>
        </div>

        <div class="filter-group">
          <h3><Icon name="solar:home-2-linear" size={18} /> Habitaciones</h3>
          <div class="step-options" aria-label="Número de habitaciones">
            <button type="button">1+</button>
            <button type="button">2+</button>
            <button type="button">3+</button>
            <button type="button">4+</button>
          </div>
        </div>

        <div class="filter-group">
          <h3><Icon name="solar:ruler-linear" size={18} /> Área (m²)</h3>
          <div class="range-track" aria-hidden="true"><span></span></div>
          <div class="range-labels"><span>0 m²</span><span>500+ m²</span></div>
        </div>

        <button class="apply-button" type="button">
          Aplicar filtros
          <Icon name="solar:tuning-2-linear" size={18} />
        </button>
      </aside>

      <div class="results-area">
        <div class="results-toolbar">
          <h2 id="results-title"><strong>18</strong> propiedades encontradas</h2>
          <label>
            <span>Ordenar por:</span>
            <select name="orden">
              <option>Más recientes</option>
              <option>Mayor precio</option>
              <option>Menor precio</option>
            </select>
          </label>
        </div>

        <div class="property-list">
          {listedProperties.map((property) => <PropertyListCard image={propertyImage} property={property} />)}
        </div>

        <nav class="pagination" aria-label="Paginación de propiedades">
          <a href="/propiedades/" aria-label="Página anterior"><Icon name="solar:alt-arrow-left-linear" size={18} /></a>
          <a class="active" href="/propiedades/" aria-current="page">1</a>
          <a href="/propiedades/">2</a>
          <a href="/propiedades/">3</a>
          <a href="/propiedades/" aria-label="Página siguiente"><Icon name="solar:alt-arrow-right-linear" size={18} /></a>
        </nav>
      </div>
    </section>

    <div class="support-shell">
      <CtaBanner
        labelledBy="support-title"
        title="¿No encuentras lo que buscas?"
        copy="Cuéntanos qué necesitas y te ayudamos a encontrar la propiedad ideal."
        href="/contacto/"
        label="Contáctanos"
      />
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .properties-hero {
    position: relative;
    padding: 152px 0 0;
    background: linear-gradient(180deg, #ffffff 0%, #ffffff 78%, #f7fbff 100%);
  }

  .hero-inner,
  .search-panel,
  .properties-shell,
  .support-shell {
    width: min(calc(100% - var(--site-padding-x)), var(--site-max-width));
    margin-inline: auto;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(300px, 0.9fr) minmax(420px, 1.15fr);
    align-items: end;
    gap: 56px;
    min-height: 300px;
  }

  .hero-copy {
    padding-bottom: 76px;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    margin: 0 0 16px;
    color: var(--color-green-dark);
    font-size: 0;
    font-weight: 700;
  }

  .kicker::before {
    content: "";
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-teal);
  }

  h1 {
    margin: 0;
    color: var(--color-navy);
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 6.2vw, 5.8rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0;
  }

  .hero-copy > p:last-child {
    max-width: 410px;
    margin: 28px 0 0;
    color: rgba(0, 0, 67, 0.68);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .hero-media img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .search-panel {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(260px, 1.45fr) minmax(190px, 0.7fr) minmax(190px, 0.7fr) auto;
    gap: 18px;
    margin-top: -24px;
    padding: 28px;
    border: 1px solid rgba(0, 0, 67, 0.09);
    border-radius: 8px;
    background: #ffffff;
    box-shadow: var(--shadow-panel);
  }

  .search-keyword,
  .select-field,
  .results-toolbar label {
    display: grid;
    align-items: center;
    min-height: 68px;
    border: 1px solid rgba(0, 0, 67, 0.12);
    border-radius: 8px;
    background: #ffffff;
  }

  .search-keyword {
    grid-template-columns: auto 1fr;
    gap: 14px;
    padding: 0 20px;
    color: var(--color-navy);
  }

  input,
  select {
    width: 100%;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--color-navy);
    font: inherit;
    font-weight: 700;
    outline: none;
  }

  .select-field {
    grid-template-rows: auto auto;
    gap: 4px;
    padding: 11px 16px;
  }

  .select-field span,
  .results-toolbar label span {
    color: rgba(0, 0, 67, 0.58);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .search-button,
  .apply-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 58px;
    border-radius: 8px;
    font-weight: 700;
    cursor: pointer;
  }

  .search-button {
    min-width: 220px;
    border: 0;
    background: var(--color-blue);
    color: #ffffff;
    box-shadow: var(--shadow-button);
  }

  .properties-shell {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: 36px;
    padding: 34px 0 0;
  }

  .filters-panel {
    align-self: start;
    padding: 28px 24px;
    border: 1px solid rgba(0, 0, 67, 0.09);
    border-radius: 8px;
    background: #ffffff;
    box-shadow: 0 16px 38px rgba(0, 0, 67, 0.05);
  }

  .filters-heading,
  .results-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .filters-heading h2,
  .results-toolbar h2 {
    margin: 0;
    color: rgba(0, 0, 67, 0.66);
    font-family: var(--font-sans);
    font-size: 1.18rem;
    font-weight: 700;
  }

  .filters-heading button {
    border: 0;
    background: transparent;
    color: var(--color-blue);
    font-weight: 700;
    cursor: pointer;
  }

  .filter-group {
    padding: 28px 0;
    border-bottom: 1px solid rgba(0, 0, 67, 0.1);
  }

  .filter-group:last-of-type {
    border-bottom: 0;
  }

  .filter-group h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 16px;
    font-size: 0.98rem;
  }

  .select-field.compact {
    min-height: 48px;
    padding: 0 12px;
  }

  .check-row {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 32px;
    color: rgba(0, 0, 67, 0.76);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .check-row input {
    width: 18px;
    height: 18px;
    accent-color: var(--color-blue);
  }

  .range-track {
    position: relative;
    height: 18px;
  }

  .range-track::before,
  .range-track span {
    content: "";
    position: absolute;
    top: 7px;
    left: 0;
    right: 0;
    height: 4px;
    border-radius: 999px;
  }

  .range-track::before {
    background: rgba(0, 0, 67, 0.1);
  }

  .range-track span {
    background: var(--color-teal);
  }

  .range-labels {
    display: flex;
    justify-content: space-between;
    margin-top: 10px;
    color: rgba(0, 0, 67, 0.66);
    font-size: 0.92rem;
    font-weight: 700;
  }

  .step-options {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }

  .step-options button {
    min-height: 40px;
    border: 1px solid rgba(0, 0, 67, 0.14);
    border-radius: 8px;
    background: #ffffff;
    color: rgba(0, 0, 67, 0.64);
    font-weight: 700;
    cursor: pointer;
  }

  .apply-button {
    width: 100%;
    margin-top: 22px;
    border: 1.5px solid var(--color-teal);
    background: #ffffff;
    color: var(--color-green-dark);
  }

  .results-toolbar {
    min-height: 64px;
    margin-bottom: 28px;
  }

  .results-toolbar h2 strong {
    color: var(--color-green);
    font-size: 1.45rem;
  }

  .results-toolbar label {
    grid-template-columns: auto minmax(130px, 1fr);
    gap: 12px;
    min-height: 52px;
    padding: 0 14px;
  }

  .property-list {
    display: grid;
    gap: 22px;
  }

  .pagination {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 32px;
  }

  .pagination a {
    display: grid;
    min-width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid rgba(0, 0, 67, 0.12);
    border-radius: 8px;
    color: var(--color-navy);
    font-weight: 700;
  }

  .pagination a.active {
    border-color: var(--color-blue);
    background: var(--color-blue);
    color: #ffffff;
  }

  .support-shell {
    margin-top: 52px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1180px) {
    .hero-inner,
    .properties-shell {
      grid-template-columns: 1fr;
    }

    .hero-copy {
      padding-bottom: 0;
    }

    .search-panel {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 26px;
    }

    .search-keyword,
    .search-button {
      grid-column: 1 / -1;
    }

    .filters-panel {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px 28px;
    }

    .filters-heading,
    .apply-button {
      grid-column: 1 / -1;
    }

    .filter-group {
      border-bottom: 0;
    }
  }

  @media (max-width: 760px) {
    .properties-hero {
      padding-top: 108px;
    }

    .hero-inner,
    .search-panel,
    .properties-shell,
    .support-shell {
      width: min(calc(100% - var(--site-padding-x-mobile)), var(--site-max-width));
    }

    h1 {
      font-size: clamp(2.55rem, 12.8vw, 3.12rem);
    }

    .hero-copy > p:last-child {
      font-size: 1rem;
    }

    .search-panel,
    .filters-panel {
      grid-template-columns: 1fr;
      padding: 18px;
    }

    .search-keyword,
    .search-button,
    .filters-heading,
    .apply-button {
      grid-column: auto;
    }

    .results-toolbar {
      display: grid;
      align-items: stretch;
    }

    .filters-heading {
      display: grid;
      justify-content: start;
      gap: 10px;
    }

    .results-toolbar label {
      grid-template-columns: 1fr;
      gap: 4px;
      padding: 9px 14px;
    }
  }
</style>
