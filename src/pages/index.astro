---
import { Icon } from 'astro-icon/components';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import IconCardGrid from '@/components/sections/IconCardGrid.astro';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import PropertyFeatureCard from '@/components/properties/PropertyFeatureCard.astro';
import { featuredProperties, homeBenefits } from '@/data/siteContent';
---

<BaseLayout
  title="Amaru FS Inmobiliaria"
  description="Encuentra propiedades en venta y alquiler con Amaru FS Inmobiliaria."
>
  <main>
    <SiteHeader />

    <section class="home-hero" aria-labelledby="home-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <h1 id="home-title">
            Tu próximo <span class="mobile-break">hogar</span>
            <span class="accent">empieza aquí</span>
          </h1>
          <p>
            Te acompañamos a encontrar la propiedad ideal con un servicio cercano y
            transparente.
          </p>

          <div class="hero-actions">
            <a class="primary-button" href="/propiedades/">Ver propiedades</a>
            <a class="play-link" href="#porque-elegirnos">
              <span><Icon name="solar:play-bold" size={15} /></span>
              Conoce más
            </a>
          </div>

          <div class="trust-list" aria-label="Beneficios principales">
            <div>
              <span class="trust-icon green"><Icon name="solar:user-rounded-linear" size={22} /></span>
              <p>Atención personalizada</p>
            </div>
            <div>
              <span class="trust-icon blue"><Icon name="solar:clipboard-check-linear" size={22} /></span>
              <p>Procesos transparentes</p>
            </div>
            <div>
              <span class="trust-icon purple"><Icon name="solar:shield-check-linear" size={22} /></span>
              <p>Asesoría en cada paso</p>
            </div>
          </div>
        </div>

        <div class="hero-media">
          <img
            src="/images/home/hero.png"
            alt="Casa moderna representativa de Amaru FS Inmobiliaria"
            width="880"
            height="760"
          />
        </div>
      </div>
    </section>

    <section class="search-panel container" aria-label="Buscar propiedades">
      <div class="search-field">
        <Icon name="solar:map-point-linear" size={24} />
        <span><small>Ubicación</small><strong>Todas las ubicaciones</strong></span>
        <Icon name="solar:alt-arrow-down-linear" size={18} />
      </div>
      <div class="search-field">
        <Icon name="solar:home-2-linear" size={24} />
        <span><small>Tipo de propiedad</small><strong>Todos los tipos</strong></span>
        <Icon name="solar:alt-arrow-down-linear" size={18} />
      </div>
      <div class="search-field">
        <Icon name="solar:dollar-linear" size={24} />
        <span><small>Rango de precio</small><strong>Cualquier rango</strong></span>
        <Icon name="solar:alt-arrow-down-linear" size={18} />
      </div>
      <button class="search-button" type="button">
        <Icon name="solar:magnifer-linear" size={20} />
        Buscar
      </button>
    </section>

    <section class="featured container" aria-labelledby="featured-title">
      <div class="split-heading">
        <SectionHeading
          align="left"
          eyebrow="Propiedades destacadas"
          title="Propiedades seleccionadas para ti"
        />
        <a href="/propiedades/">Ver todas las propiedades <Icon name="solar:arrow-right-linear" size={18} /></a>
      </div>

      <div class="property-grid">
        {featuredProperties.map((property) => <PropertyFeatureCard property={property} />)}
      </div>
    </section>

    <section class="why-section" id="porque-elegirnos" aria-labelledby="why-title">
      <div class="container">
        <SectionHeading
          eyebrow="¿Por qué elegirnos?"
          title="Hacemos que todo el proceso sea más simple"
        />
        <IconCardGrid items={homeBenefits} columns={4} variant="stacked" />

        <aside class="newsletter" aria-labelledby="newsletter-title">
          <div class="newsletter-copy">
            <span><Icon name="solar:letter-linear" size={32} /></span>
            <div>
              <h2 id="newsletter-title">Recibe oportunidades exclusivas</h2>
              <p>Sé el primero en conocer nuevas propiedades y oportunidades del mercado.</p>
            </div>
          </div>
          <form class="newsletter-form" action="#" aria-label="Suscripción informativa">
            <label class="sr-only" for="newsletter-email">Tu correo electrónico</label>
            <input id="newsletter-email" type="email" placeholder="Tu correo electrónico" />
            <button type="submit">Suscribirme</button>
            <small>No enviamos spam. Puedes darte de baja cuando quieras.</small>
          </form>
          <Icon class="newsletter-mark" name="solar:buildings-2-linear" size={180} />
        </aside>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .container {
    width: min(calc(100% - var(--site-padding-x)), var(--site-max-width));
    margin-inline: auto;
  }

  .home-hero {
    min-height: 930px;
    padding-top: 108px;
    overflow: hidden;
    background:
      radial-gradient(circle at 85% 40%, rgba(18, 70, 192, 0.16), transparent 28%),
      linear-gradient(180deg, #ffffff 0%, #ffffff 78%, #f6fbff 100%);
  }

  .hero-inner {
    width: min(calc(100% - var(--site-padding-x)), var(--site-max-width));
    margin: 36px auto 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 40px;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    padding-bottom: 148px;
  }

  h1 {
    max-width: 760px;
    margin: 0;
    color: var(--color-navy);
    font-family: var(--font-display);
    font-size: clamp(3.8rem, 5.45vw, 5.35rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: 0;
  }

  h1 .accent {
    display: block;
    color: var(--color-green);
  }

  .mobile-break {
    display: inline;
  }

  .hero-copy > p {
    max-width: 600px;
    margin: 42px 0 0;
    color: rgba(0, 0, 67, 0.68);
    font-size: 1.5rem;
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 38px;
    margin-top: 54px;
  }

  .primary-button,
  .search-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 8px;
    background: var(--color-blue);
    color: #ffffff;
    font-weight: 700;
    box-shadow: var(--shadow-button);
  }

  .primary-button {
    min-width: 188px;
    min-height: 58px;
    padding: 0 26px;
  }

  .play-link {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    color: var(--color-green-dark);
    font-weight: 700;
  }

  .play-link span,
  .trust-icon {
    display: grid;
    place-items: center;
  }

  .play-link span {
    width: 42px;
    height: 42px;
    border: 1.5px solid var(--color-teal);
    border-radius: 50%;
  }

  .trust-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    max-width: 640px;
    margin-top: 86px;
  }

  .trust-list div {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .trust-list p {
    margin: 0;
    color: rgba(0, 0, 67, 0.72);
    font-size: 0.98rem;
    line-height: 1.45;
    font-weight: 700;
  }

  .trust-icon {
    width: 48px;
    height: 48px;
    border-radius: 8px;
  }

  .green {
    background: rgba(0, 225, 173, 0.18);
    color: var(--color-green);
  }

  .blue {
    background: rgba(18, 70, 192, 0.13);
    color: var(--color-blue);
  }

  .purple {
    background: rgba(89, 91, 255, 0.14);
    color: var(--color-purple);
  }

  .hero-media {
    min-height: 690px;
  }

  .hero-media img {
    display: block;
    width: min(100%, 820px);
    min-height: 720px;
    margin-left: auto;
    object-fit: cover;
    border-radius: 30px;
  }

  .search-panel {
    position: relative;
    z-index: 8;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) 180px;
    gap: 24px;
    margin-top: -58px;
    padding: 30px;
    border: 1px solid rgba(0, 0, 67, 0.09);
    border-radius: 8px;
    background: #ffffff;
    box-shadow: var(--shadow-panel);
  }

  .search-field {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    min-height: 70px;
    padding: 0 18px;
    border: 1px solid rgba(0, 0, 67, 0.12);
    border-radius: 8px;
  }

  .search-field small {
    display: block;
    margin-bottom: 4px;
    color: rgba(0, 0, 67, 0.52);
    font-weight: 700;
  }

  .search-field strong {
    font-size: 0.98rem;
  }

  .search-button {
    gap: 12px;
    min-height: 70px;
    cursor: pointer;
  }

  .featured {
    padding: 108px 0 96px;
  }

  .split-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
  }

  .split-heading > a {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--color-blue);
    font-weight: 700;
  }

  .property-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }

  .why-section {
    padding: 72px 0 0;
    background:
      linear-gradient(180deg, rgba(0, 225, 173, 0.09), rgba(255, 255, 255, 0.95) 72%),
      #f4fffc;
  }

  .newsletter {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 42px;
    align-items: center;
    min-height: 210px;
    margin-top: 82px;
    padding: 46px 58px;
    overflow: hidden;
    border-radius: 8px;
    background: var(--color-blue);
    color: #ffffff;
    box-shadow: 0 22px 45px rgba(18, 70, 192, 0.24);
  }

  .newsletter-copy {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .newsletter-copy > span {
    display: grid;
    flex: 0 0 auto;
    width: 70px;
    height: 70px;
    place-items: center;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.22);
  }

  .newsletter h2 {
    max-width: 390px;
    margin: 0 0 16px;
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 500;
    line-height: 1.05;
  }

  .newsletter p {
    max-width: 470px;
    margin: 0;
    line-height: 1.55;
    font-weight: 700;
  }

  .newsletter-form {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr auto;
  }

  .newsletter-form input {
    min-width: 0;
    min-height: 60px;
    padding: 0 24px;
    border: 0;
    border-radius: 8px 0 0 8px;
    color: var(--color-navy);
  }

  .newsletter-form button {
    min-height: 60px;
    padding: 0 24px;
    border: 6px solid #ffffff;
    border-radius: 0 8px 8px 0;
    background: var(--color-mint);
    color: #ffffff;
    font-weight: 700;
    cursor: pointer;
  }

  .newsletter-form small {
    grid-column: 1 / -1;
    margin-top: 16px;
    font-weight: 700;
    opacity: 0.86;
  }

  .newsletter-mark {
    position: absolute;
    right: 40px;
    bottom: -10px;
    color: rgba(255, 255, 255, 0.12);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1180px) {
    .hero-inner,
    .newsletter {
      grid-template-columns: 1fr;
    }

    .hero-copy {
      padding-bottom: 0;
    }

    .hero-media,
    .hero-media img {
      min-height: 360px;
    }

    .search-panel {
      grid-template-columns: 1fr 1fr;
      margin-top: 30px;
    }

    .search-button {
      grid-column: span 2;
    }

    .property-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .container,
    .hero-inner {
      width: min(calc(100% - var(--site-padding-x-mobile)), var(--site-max-width));
    }

    .home-hero {
      min-height: auto;
      padding-top: 86px;
      padding-bottom: 24px;
    }

    h1 {
      max-width: 100%;
      font-size: clamp(2.35rem, 10vw, 3rem);
    }

    .mobile-break {
      display: block;
    }

    .hero-copy > p {
      max-width: 34ch;
      margin-top: 26px;
      font-size: 1rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 18px;
      width: 100%;
      max-width: 360px;
      margin-top: 34px;
    }

    .primary-button {
      align-self: flex-start;
      width: min(100%, 320px);
      min-width: 0;
    }

    .play-link {
      justify-content: center;
    }

    .trust-list,
    .search-panel,
    .property-grid,
    .newsletter,
    .newsletter-form {
      grid-template-columns: 1fr;
    }

    .trust-list {
      margin-top: 38px;
    }

    .search-panel {
      gap: 14px;
      padding: 16px;
    }

    .search-button {
      grid-column: auto;
    }

    .featured {
      padding: 62px 0;
    }

    .split-heading {
      display: block;
    }

    .split-heading > a {
      margin: 0 0 32px;
    }

    .newsletter {
      margin-top: 48px;
      padding: 28px;
    }

    .newsletter-copy {
      display: block;
    }

    .newsletter-copy > span {
      margin-bottom: 20px;
    }

    .newsletter h2 {
      font-size: 1.95rem;
    }

    .newsletter-form {
      gap: 12px;
    }

    .newsletter-form input,
    .newsletter-form button {
      border-radius: 8px;
    }

    .newsletter-form button {
      border: 0;
    }
  }
</style>
