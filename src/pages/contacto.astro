---
import { Icon } from 'astro-icon/components';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBanner from '@/components/sections/CtaBanner.astro';
import IconCardGrid from '@/components/sections/IconCardGrid.astro';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import SplitHero from '@/components/sections/SplitHero.astro';
import { contactBenefits, contactOptions, contactTrustItems } from '@/data/siteContent';
---

<BaseLayout
  title="Contacto | Amaru FS Inmobiliaria"
  description="Contacta a Amaru FS Inmobiliaria para recibir asesoría sobre venta, compra, alquiler o administración de propiedades."
>
  <SiteHeader />
  <main>
    <div class="page-shell">
      <SplitHero
        eyebrow="Contacto"
        title="Hablemos de tu proyecto y encontremos juntos"
        accent="la mejor solución"
        description="Estamos aquí para escucharte, responder tus preguntas y ayudarte a tomar la mejor decisión."
        labelledBy="contact-title"
      />

      <section class="benefits-section" aria-label="Beneficios al contactarnos">
        <IconCardGrid items={contactBenefits} columns={4} />
      </section>

      <section class="contact-options" aria-labelledby="options-title">
        <SectionHeading
          eyebrow="Múltiples formas de contactarnos"
          title="Elige la opción que prefieras"
        />

        <div class="option-grid">
          {
            contactOptions.map((item) => (
              <article>
                <span class:list={['icon-box', item.tone]}>
                  <Icon name={item.icon} size={28} />
                </span>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.value}</p>
                  <small>{item.detail}</small>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="contact-main" aria-label="Formulario y datos de contacto">
        <div class="message-card">
          <div class="form-heading">
            <span class="icon-box green"><Icon name="solar:plain-linear" size={30} /></span>
            <div>
              <h2>Envíanos un mensaje</h2>
              <p>Completa el formulario y nos pondremos en contacto contigo a la brevedad.</p>
            </div>
          </div>

          <form action="#" aria-label="Formulario de contacto">
            <div class="field-grid">
              <label>Nombre completo<input type="text" name="nombre" placeholder="Tu nombre" /></label>
              <label>Correo electrónico<input type="email" name="correo" placeholder="tu@correo.com" /></label>
              <label>Número de celular<input type="tel" name="telefono" placeholder="+51 987 654 321" /></label>
              <label>
                Asunto
                <select name="asunto">
                  <option>Selecciona un asunto</option>
                  <option>Comprar una propiedad</option>
                  <option>Vender una propiedad</option>
                  <option>Administrar una propiedad</option>
                  <option>Asesoría inmobiliaria</option>
                </select>
              </label>
            </div>

            <label class="message-field">
              Cuéntanos sobre tu proyecto
              <textarea name="mensaje" rows="7" maxlength="500" placeholder="Escribe aquí tu mensaje..."></textarea>
              <small>0/500 caracteres.</small>
            </label>

            <button type="submit">
              <Icon name="solar:plain-linear" size={18} />
              Enviar mensaje
            </button>

            <p class="privacy-note">
              <Icon name="solar:lock-keyhole-linear" size={16} />
              Tus datos solo se usarán para responder tu consulta.
            </p>
          </form>
        </div>

        <aside class="whatsapp-panel" aria-labelledby="whatsapp-title">
          <h2 id="whatsapp-title">¿Prefieres hablar por WhatsApp?</h2>
          <p>Escríbenos directamente y recibe atención inmediata.</p>
          <a href="https://wa.me/51987654321" target="_blank" rel="noreferrer">
            <Icon name="simple-icons:whatsapp" size={21} />
            Escribir por WhatsApp
          </a>

          <div class="panel-divider"></div>

          <h3>Información de contacto</h3>
          <address>
            <a href="tel:+51987654321"><Icon name="solar:phone-calling-linear" size={20} />+51 987 654 321</a>
            <a href="mailto:hola@amarufs.pe"><Icon name="solar:letter-linear" size={20} />hola@amarufs.pe</a>
            <span><Icon name="solar:clock-circle-linear" size={20} />Lun - Vie: 9:00 a.m. - 6:00 p.m.</span>
            <span><Icon name="solar:map-point-linear" size={20} />Av. Javier Prado Este 1235<br />San Borja, Lima - Perú</span>
          </address>
        </aside>
      </section>

      <section class="trust-section" aria-labelledby="trust-title">
        <SectionHeading
          eyebrow="¿Por qué confiar en nosotros?"
          title="Estamos comprometidos contigo"
        />
        <IconCardGrid items={contactTrustItems} columns={5} variant="divided" />
      </section>

      <CtaBanner
        labelledBy="contact-cta-title"
        title="¿Listo para dar el siguiente paso?"
        copy="Permítenos ayudarte a encontrar la mejor oportunidad o gestionar tu propiedad de la manera más eficiente."
        href="/propiedades/"
        label="Ver propiedades"
      />
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .page-shell {
    width: min(calc(100% - var(--site-padding-x)), var(--site-max-width));
    margin-inline: auto;
  }

  .benefits-section {
    padding: 66px 0 18px;
  }

  .contact-options {
    padding: 38px 0;
  }

  .option-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .option-grid article,
  .message-card,
  .whatsapp-panel {
    border: 1px solid rgba(0, 0, 67, 0.1);
    border-radius: 8px;
    background: #ffffff;
    box-shadow: 0 18px 42px rgba(0, 0, 67, 0.06);
  }

  .option-grid article {
    display: grid;
    grid-template-columns: 66px 1fr;
    gap: 18px;
    align-items: center;
    min-height: 154px;
    padding: 28px;
  }

  .icon-box {
    display: grid;
    width: 60px;
    height: 60px;
    place-items: center;
    border-radius: 8px;
  }

  .green {
    background: rgba(0, 225, 173, 0.18);
    color: var(--color-green-dark);
  }

  .blue {
    background: rgba(18, 70, 192, 0.13);
    color: var(--color-blue);
  }

  .purple {
    background: rgba(89, 91, 255, 0.14);
    color: var(--color-purple);
  }

  h2,
  h3 {
    color: var(--color-navy);
    letter-spacing: 0;
  }

  h3,
  .option-grid p,
  .option-grid small {
    margin: 0;
  }

  h3 {
    margin-bottom: 8px;
    font-size: 1rem;
  }

  .option-grid p,
  .option-grid small {
    color: rgba(0, 0, 67, 0.62);
    font-weight: 700;
    line-height: 1.55;
  }

  .contact-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 440px;
    gap: 28px;
    padding: 0 0 62px;
  }

  .message-card {
    padding: 40px;
  }

  .form-heading {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-bottom: 30px;
  }

  .form-heading h2,
  .whatsapp-panel h2 {
    margin: 0 0 8px;
    font-size: 1.75rem;
  }

  .form-heading p,
  .whatsapp-panel p {
    margin: 0;
    color: rgba(0, 0, 67, 0.65);
    font-weight: 700;
    line-height: 1.55;
  }

  .field-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px 26px;
  }

  label {
    display: grid;
    gap: 10px;
    color: var(--color-navy);
    font-weight: 700;
  }

  input,
  select,
  textarea {
    width: 100%;
    min-width: 0;
    border: 1px solid rgba(0, 0, 67, 0.14);
    border-radius: 8px;
    background: #ffffff;
    color: var(--color-navy);
    font: inherit;
    font-weight: 700;
    outline: none;
  }

  input,
  select {
    min-height: 56px;
    padding: 0 18px;
  }

  textarea {
    resize: vertical;
    padding: 18px;
  }

  .message-field {
    margin-top: 22px;
  }

  .message-field small,
  .privacy-note {
    color: rgba(0, 0, 67, 0.48);
    font-weight: 700;
  }

  .message-card button,
  .whatsapp-panel > a {
    display: inline-flex;
    width: 100%;
    min-height: 58px;
    align-items: center;
    justify-content: center;
    gap: 12px;
    border: 0;
    border-radius: 8px;
    background: var(--color-blue);
    color: #ffffff;
    font-weight: 700;
    cursor: pointer;
    box-shadow: var(--shadow-button);
  }

  .message-card button {
    margin-top: 22px;
  }

  .privacy-note {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    margin: 22px 0 0;
  }

  .whatsapp-panel {
    padding: 48px;
    background: var(--color-navy);
    color: #ffffff;
  }

  .whatsapp-panel h2,
  .whatsapp-panel h3 {
    color: #ffffff;
  }

  .whatsapp-panel h2 {
    max-width: 300px;
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 500;
    line-height: 1.12;
  }

  .whatsapp-panel p {
    color: rgba(255, 255, 255, 0.8);
    margin: 26px 0;
  }

  .whatsapp-panel > a {
    background: var(--color-green);
    box-shadow: none;
  }

  .panel-divider {
    height: 1px;
    margin: 40px 0 34px;
    background: rgba(255, 255, 255, 0.28);
  }

  address {
    display: grid;
    gap: 20px;
    font-style: normal;
  }

  address a,
  address span {
    display: flex;
    align-items: start;
    gap: 14px;
    color: rgba(255, 255, 255, 0.9);
    font-weight: 700;
    line-height: 1.45;
  }

  .trust-section {
    padding: 24px 0 54px;
  }

  @media (max-width: 1180px) {
    .contact-main {
      grid-template-columns: 1fr;
    }

    .option-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .page-shell {
      width: min(calc(100% - var(--site-padding-x-mobile)), var(--site-max-width));
    }

    .option-grid,
    .field-grid {
      grid-template-columns: 1fr;
    }

    .message-card,
    .whatsapp-panel {
      padding: 26px;
    }

    .form-heading {
      align-items: start;
    }

    .whatsapp-panel h2 {
      font-size: 1.9rem;
    }
  }
</style>
