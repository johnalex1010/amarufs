---
import { Icon } from 'astro-icon/components';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBanner from '@/components/sections/CtaBanner.astro';
import IconCardGrid from '@/components/sections/IconCardGrid.astro';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import SplitHero from '@/components/sections/SplitHero.astro';
import {
  aboutBenefits,
  aboutServices,
  aboutTrustItems,
  aboutValues,
} from '@/data/siteContent';
---

<BaseLayout
  title="Nosotros | Amaru FS Inmobiliaria"
  description="Conoce a Amaru FS Inmobiliaria, una empresa enfocada en venta, administración y asesoría inmobiliaria con servicio cercano y transparente."
>
  <SiteHeader />
  <main>
    <div class="page-shell">
      <SplitHero
        eyebrow="Sobre Amaru FS"
        title="Más que una inmobiliaria,"
        accent="somos tu aliado."
        description="En Amaru FS ayudamos a personas y empresas a encontrar el lugar ideal para vivir o invertir, con un servicio cercano, profesional y transparente."
        labelledBy="about-title"
      />

      <section class="values-section" aria-label="Valores de Amaru FS">
        <IconCardGrid items={aboutValues} columns={4} />
      </section>

      <section class="services-section" aria-labelledby="services-title">
        <SectionHeading
          eyebrow="Nuestros servicios"
          title="Soluciones inmobiliarias integrales para ti"
          description="Ofrecemos servicios especializados para que tomes las mejores decisiones con respaldo profesional en cada etapa."
        />

        <div class="service-grid">
          {
            aboutServices.map((service) => (
              <article class="service-card">
                <div class="service-content">
                  <span class:list={['icon-box', service.tone]}>
                    <Icon name={service.icon} size={34} />
                  </span>
                  <p class:list={['service-eyebrow', service.tone]}>{service.eyebrow}</p>
                  <h3>{service.title}</h3>
                  <p>{service.copy}</p>
                  <ul>
                    {
                      service.bullets.map((bullet) => (
                        <li>
                          <Icon name="solar:check-circle-linear" size={17} />
                          {bullet}
                        </li>
                      ))
                    }
                  </ul>
                  <a href="/propiedades/">
                    Conocer más
                    <Icon name="solar:arrow-right-linear" size={18} />
                  </a>
                </div>
                <div class="service-image-slot" aria-label={`Imagen de apoyo para ${service.title}`}></div>
              </article>
            ))
          }
        </div>
      </section>
    </div>

    <section class="trust-section" aria-labelledby="trust-title">
      <SectionHeading
        eyebrow="Confiabilidad que nos respalda"
        title="Tu tranquilidad es nuestra prioridad"
      />
      <IconCardGrid items={aboutTrustItems} columns={5} variant="divided" />
    </section>

    <div class="page-shell">
      <section class="benefits-section" aria-labelledby="benefits-title">
        <SectionHeading
          eyebrow="¿Por qué elegirnos?"
          title="Beneficios de estar con Amaru FS"
        />
        <IconCardGrid items={aboutBenefits} columns={5} variant="divided" />
      </section>

      <CtaBanner
        labelledBy="about-cta-title"
        title="¿Tienes una propiedad o buscas una oportunidad?"
        copy="Hablemos y te ayudaremos a lograrlo."
        href="/contacto/"
        label="Contáctanos"
      />
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .page-shell {
    width: min(calc(100% - var(--site-padding-x)), var(--site-max-width));
    margin-inline: auto;
  }

  .values-section {
    padding: 72px 0 0;
  }

  .services-section {
    padding: 72px 0 36px;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 34px;
  }

  .service-card {
    display: grid;
    grid-template-columns: 1fr minmax(210px, 0.86fr);
    min-height: 520px;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 67, 0.1);
    border-radius: 8px;
    background: #ffffff;
    box-shadow: var(--shadow-card);
  }

  .service-content {
    display: grid;
    align-content: center;
    padding: 44px 38px;
  }

  .icon-box {
    display: grid;
    width: 64px;
    height: 64px;
    place-items: center;
    border-radius: 8px;
  }

  .green {
    background: rgba(0, 225, 173, 0.18);
    color: var(--color-green-dark);
  }

  .blue {
    background: rgba(18, 70, 192, 0.13);
    color: var(--color-blue);
  }

  .service-eyebrow {
    margin: 28px 0 24px;
    background: transparent;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3 {
    max-width: 300px;
    margin: 0;
    color: var(--color-navy);
    font-family: var(--font-display);
    font-size: 2.15rem;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: 0;
  }

  .service-content > p:not(.service-eyebrow) {
    margin: 26px 0 24px;
    color: rgba(0, 0, 67, 0.66);
    font-weight: 700;
    line-height: 1.58;
  }

  ul {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: rgba(0, 0, 67, 0.72);
    font-weight: 700;
  }

  li svg {
    color: var(--color-green);
  }

  .service-content a {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    width: fit-content;
    margin-top: 34px;
    color: var(--color-blue);
    font-weight: 700;
  }

  .service-image-slot {
    min-height: 100%;
    overflow: hidden;
    border-radius: 0;
    background:
      linear-gradient(135deg, rgba(18, 70, 192, 0.08), rgba(0, 225, 173, 0.12)),
      #f7fbff;
  }

  .trust-section {
    width: 100%;
    padding: 70px max(var(--site-padding-x), calc((100% - var(--site-max-width)) / 2));
    background: linear-gradient(180deg, rgba(0, 225, 173, 0.1), rgba(255, 255, 255, 0.92));
  }

  .benefits-section {
    padding: 70px 0 52px;
  }

  @media (max-width: 1180px) {
    .service-grid {
      grid-template-columns: 1fr;
    }

    .service-card {
      grid-template-columns: 1fr 0.8fr;
    }
  }

  @media (max-width: 760px) {
    .page-shell {
      width: min(calc(100% - var(--site-padding-x-mobile)), var(--site-max-width));
    }

    .trust-section {
      padding-inline: var(--site-padding-x-mobile);
    }

    .service-card {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .service-content {
      padding: 32px 24px;
    }

    h3 {
      font-size: 1.85rem;
    }

    .service-image-slot {
      min-height: 260px;
    }
  }
</style>
